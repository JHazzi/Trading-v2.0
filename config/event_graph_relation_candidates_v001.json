{
  "version": "event_graph_relation_candidates_v001",
  "corpus_db": "data/processed/event_graph_sec_relation_corpus_v001.db",
  "main_db": "data/database/market_data_v2.db",
  "output_db": "data/processed/event_graph_relation_candidates_v001.db",
  "report_dir": "reports/event_graph/relation_candidates_v001",
  "mutates_main_database": false,
  "writes_graph_edges": false,
  "strict_historical_pit": false,
  "primary_extractors": {
    "exhibit21_parent_of_v001": {
      "enabled": true,
      "document_classes": [
        "subsidiary_exhibit"
      ],
      "relation_type": "parent_of",
      "precision_policy": "high_precision_suffix_anchored_lines"
    },
    "agreement_counterparty_v001": {
      "enabled": true,
      "document_classes": [
        "material_contract_exhibit",
        "transaction_exhibit"
      ],
      "relation_type": "contract_party_of",
      "search_prefix_chars": 24000,
      "preamble_markers": [
        "by and between",
        "by and among",
        "among the following"
      ],
      "precision_policy": "legal_entity_names_near_explicit_party_preamble"
    }
  },
  "deferred_extractors": [
    "supplier_of",
    "customer_of",
    "depends_on",
    "partner_of",
    "competitor_of",
    "regulated_by",
    "exposed_to",
    "operates_in",
    "produces",
    "uses",
    "financed_by"
  ],
  "entity_resolution": {
    "automatic_methods": [
      "exact_unique_entity_name",
      "exact_unique_asset_name",
      "exact_unique_asset_ticker"
    ],
    "fuzzy_auto_resolution": false,
    "create_entities": false,
    "strip_legal_suffix_for_auto_match": false
  },
  "candidate_contract": {
    "candidates_are_not_model_visible": true,
    "candidates_are_not_graph_edges": true,
    "market_direction_assigned": false,
    "market_weight_assigned": false,
    "candidate_sign_assigned": false,
    "availability_is_point_in_time": 0,
    "candidate_source_clock": "corpus_document.effective_available_at",
    "evidence_span_required": true,
    "raw_sha256_required": true
  },
  "qa": {
    "sample_per_extractor": 60,
    "sample_per_resolution_status": 30,
    "deterministic_hash_sampling": true,
    "manual_labels": [
      "supported",
      "unsupported",
      "ambiguous",
      "wrong_entity_boundary",
      "wrong_relation_type"
    ]
  },
  "promotion_gate": {
    "no_promotion_in_this_package": true,
    "requires_manual_precision_review": true,
    "requires_entity_resolution_audit": true,
    "requires_temporal_evidence_audit": true
  }
}
