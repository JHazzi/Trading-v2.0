    "provider_sentiment_is_annotation_only": true,
    "no_direction_mapping": true,
    "no_source_reliability_hardcoding": true,
    "no_event_impact_hardcoding": true,
    "cluster_before_event_effect": true,
    "historical_import_without_observed_available_at_is_strict_pit": false
  }
}
