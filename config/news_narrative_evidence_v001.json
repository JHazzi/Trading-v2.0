{
  "contract_version": "news_narrative_evidence_v001",
  "capture_db": "data/database/information_capture_v001.db",
  "schema_additive": "database/news_narrative_evidence_v001_additive.sql",
  "feature_visibility": "blocked_until_separate_preregistered_experiment",
  "provider": {
    "name": "alpha_vantage",
    "endpoint": "NEWS_SENTIMENT",
    "enabled": true,
    "limit": 1000,
    "timeout_seconds": 45
