{
  "version": "market_temporal_dataset_v001",
  "status": "source_audit_then_materialize_no_training",
  "purpose": "Build horizon-conditioned terminal-return outcomes without treating discrete horizons as the final representation of time.",
  "source_contract": {
    "canonical_market_db": "data/database/market_data_v2.db",
    "market_core_db": "data/processed/market_daily_v003_core.db",
    "source_asof_contract": "daily_price_asof_v1",
    "source_asof_mode": "historical_session_close_assumption",
    "state_clock": "exchange_session_close",
    "strict_historical_pit": false,
    "market_feature_version": "market_daily_state_v003_core",
    "existing_label_version": "market_daily_reaction_v003_core",
    "existing_target": "raw_close_t_to_raw_close_t_plus_h"
  },
  "horizon_contract": {
    "existing_evaluation_sessions": [1, 3, 5, 10],
    "training_anchor_sessions": [1, 2, 3, 5, 8, 10, 13, 21, 34, 63, 126, 252],
    "temporal_generalization_holdout_sessions": [7, 17, 42, 90, 180],
    "materialized_sessions": [1, 2, 3, 5, 7, 8, 10, 13, 17, 21, 34, 42, 63, 90, 126, 180, 252],
    "maximum_sessions": 252,
    "holdouts_are_never_model_selection_inputs": true,
    "arbitrary_tau_must_be_learned_not_output_interpolation": true
  },
  "raw_close_label_contract": {
    "phase": "parity_and_selection_audit",
    "primary_outcome": "return_pct",
    "formula": "100 * (raw_close_target / raw_close_origin - 1)",
    "origin": "exact Market V003 Core state trading-day exchange close",
    "target": "raw close exactly tau eligible exchange sessions after origin",
    "corporate_action_policy": "exclude_any_present_action_in_open_closed_horizon",
    "insufficient_future_policy": "explicit_status_no_synthetic_target",
    "future_outcomes_are_features": false,
    "provider_adjusted_close_allowed_as_silent_substitute": false
  },
  "parity_gate": {
    "required_horizons_sessions": [1, 3, 5, 10],
    "compare_key": ["state_id", "asset_id", "origin_trading_day", "horizon_sessions"],
    "compare_fields": [
      "target_trading_day",
      "return_pct",
      "corporate_action_overlap",
      "label_status"
    ],
    "return_absolute_tolerance": 1e-09,
    "require_zero_missing_reference_rows": true,
    "training_blocked_if_parity_fails": true
  },
  "corporate_action_gate": {
    "audit_horizons_sessions": [21, 63, 126, 252],
    "report_by": ["horizon", "asset", "sector", "year"],
    "raw_close_long_horizon_training_authorized_before_review": false,
    "reason": "Long raw-close windows may overlap dividends/splits so frequently that exclusion creates severe selection bias.",
    "if_overlap_is_material": "define_and_validate_separate_causal_total_return_label_version",
    "total_return_must_reconstruct_actions_with_explicit_asof_lineage": true,
    "provider_adjusted_close_is_not_automatically_causal": true
  },
  "materialization_contract": {
    "output_db": "data/processed/market_temporal_v001.db",
    "dataset_contract": "market_temporal_horizon_conditioned_outcomes_v001",
    "label_version": "market_temporal_terminal_return_v001",
    "source_and_core_are_read_only": true,
    "idempotent_rebuild": true,
    "phase_1_fields": [
      "state_id",
      "asset_id",
      "ticker",
      "sector",
      "origin_trading_day",
      "target_trading_day",
      "tau_sessions",
      "return_pct",
      "corporate_action_overlap",
      "label_status"
    ],
    "phase_2_path_fields_after_parity_gate": [
      "mfe_pct",
      "mae_pct",
      "realized_path_vol_pct"
    ]
  },
  "future_model_boundary": {
    "target_form": "Q_q(R | X, tau)",
    "tau_is_explicit_model_input": true,
    "quantiles": [0.05, 0.25, 0.5, 0.75, 0.95],
    "dense_marginals_are_not_a_coherent_path": true,
    "joint_path_model_is_separate_future_gate": true
  },
  "guards": {
    "training_authorized": false,
    "benchmark_results_authorized": false,
    "v009_artifacts_loaded_or_modified": false,
    "v009_fit_used": false,
    "source_market_db_mutation_allowed": false,
    "market_v003_core_mutation_allowed": false,
    "event_features_allowed": false,
    "graph_features_allowed": false,
    "random_split_allowed": false
  }
}
